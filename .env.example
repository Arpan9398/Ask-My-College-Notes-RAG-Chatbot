# Copy this file to ".env" and fill in ONE provider's key. Never commit ".env".

# Which LLM generates the answers: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OpenAI (only if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Retrieval tuning (all optional) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
# Chunks whose cosine similarity to the question is below this are ignored.
# If nothing passes, the app answers "not found" without calling the LLM.
MIN_RELEVANCE=0.20
MAX_UPLOAD_MB=50
